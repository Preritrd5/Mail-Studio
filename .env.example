# ==============================================================================
# SNPSUNEXUS MAIL STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env and provide your specific institutional credentials.
# ==============================================================================

# Frontend (Vite) Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Leave VITE_API_BASE_URL unset on Vercel (uses same-origin /api serverless routes automatically).
# For local development against standalone backend on port 4000:
VITE_API_BASE_URL=http://localhost:4000

# Server Environment Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:4000

# Backend Supabase Configuration (Never expose to browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Institutional SMTP Configuration (Phase 4)
GMAIL_USER=your-service-account@snpsu.edu.in
GMAIL_APP_PASSWORD=your-secure-app-password
